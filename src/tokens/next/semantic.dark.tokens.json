          "$type": "color",
          "$value": "{color.base.border}"
        }
      }
    },
    "font": {
      "body": {
        "$type": "fontFamily",
        "$value": "{font.sans}"
      },
      "display": {
        "$type": "fontFamily",
        "$value": "{font.sans}"
      },
      "ui": {
        "$type": "fontFamily",
        "$value": "{font.sans}"
      }
    }
