{
  "component": {
    "terminal": {
      "background": {
        "$type": "color",
        "$value": "{semantic.color.surface}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{semantic.color.ink.primary}"
      },
      "accent": {
        "$type": "color",
        "$value": "{semantic.color.accent.primary}"
      },
      "success": {
        "$type": "color",
        "$value": "{semantic.color.accent.success}"
      },
      "error": {
        "$type": "color",
        "$value": "{semantic.color.accent.danger}"
      }
    },
    "card": {
      "border": {
        "$type": "color",
        "$value": "{semantic.color.border.subtle}"
      }
    }
  }
}
