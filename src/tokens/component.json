{
  "component": {
    "terminal": {
      "background": {
        "$type": "color",
        "$value": "{color.surface}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.ink.primary}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.accent.primary}"
      },
      "success": {
        "$type": "color",
        "$value": "{color.accent.success}"
      },
      "error": {
        "$type": "color",
        "$value": "{color.accent.danger}"
      }
    },
    "card": {
      "border": {
        "$type": "color",
        "$value": "{color.border.subtle}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": {
          "color": "rgba(0, 0, 0, 0.45)",
          "offsetX": "0px",
          "offsetY": "30px",
          "blur": "80px",
          "spread": "0px"
        }
      }
    }
  }
}
