{
  "$description": "Names the site's CSS already used, pointed at Primitree's output. Each entry is a CSS custom property and the token it stands for. A string is a plain alias. An object adds the CSS wrapped around the token's variable, where {var} is that variable. scripts/tokens/build.mjs writes these to src/styles/generated/theme.css and into the inspector's graph, so the inspector reads the same list the stylesheet does.",
  "tailwind": {
    "--color-canvas": "semantic.color.surface.canvas",
    "--color-surface": "semantic.color.surface.base",
    "--color-surface-raised": "semantic.color.surface.raised",
    "--color-ink-primary": "semantic.color.ink.primary",
    "--color-ink-secondary": "semantic.color.ink.secondary",
    "--color-ink-muted": "semantic.color.ink.muted",
    "--color-border-subtle": "semantic.color.border.subtle",
    "--color-border-image": "semantic.color.border.image",
    "--color-accent-primary": "semantic.color.accent.primary",
    "--color-accent-text": "semantic.color.accent.text",
    "--color-on-accent": "semantic.color.ink.onAccent",
    "--color-accent-success": "semantic.color.status.pass",
    "--color-accent-warning": "semantic.color.status.warn",
    "--color-accent-danger": "semantic.color.status.fail",
    "--font-body": "semantic.font.body",
    "--font-ui": "semantic.font.body",
    "--font-display": "semantic.font.body",
    "--font-sans": "semantic.font.body",
    "--font-mono": "semantic.font.code",
    "--text-specimen": { "token": "semantic.type.specimen.size", "css": "clamp(3.5rem, 15vw, {var})" },
    "--leading-specimen": "semantic.type.specimen.leading",
    "--tracking-specimen": { "token": "semantic.type.specimen.tracking", "css": "calc({var} * 1em)" },
    "--text-display": { "token": "semantic.type.display.size", "css": "clamp(3rem, 6vw, {var})" },
    "--text-title": { "token": "semantic.type.title.size", "css": "clamp(2.5rem, 4.5vw, {var})" },
    "--text-heading": { "token": "semantic.type.heading.size", "css": "clamp(2rem, 3vw, {var})" },
    "--text-subheading": "semantic.type.subheading.size",
    "--text-body": { "token": "semantic.type.body.size", "css": "clamp(1.125rem, 1.05rem + 0.25vw, {var})" },
    "--text-lead": "semantic.type.lead.size",
    "--text-ui": "semantic.type.ui.size",
    "--text-caption": "semantic.type.caption.size",
    "--leading-display": "semantic.type.display.leading",
    "--leading-title": "semantic.type.title.leading",
    "--leading-heading": "semantic.type.heading.leading",
    "--leading-subheading": "semantic.type.subheading.leading",
    "--leading-body": "semantic.type.body.leading",
    "--leading-lead": "semantic.type.lead.leading",
    "--leading-ui": "semantic.type.ui.leading",
    "--leading-caption": "semantic.type.caption.leading",
    "--text-code": "semantic.type.code.size",
    "--leading-code": "semantic.type.code.leading",
    "--tracking-display": { "token": "semantic.type.display.tracking", "css": "calc({var} * 1em)" },
    "--tracking-title": { "token": "semantic.type.title.tracking", "css": "calc({var} * 1em)" },
    "--tracking-heading": { "token": "semantic.type.heading.tracking", "css": "calc({var} * 1em)" },
    "--tracking-body": { "token": "semantic.type.body.tracking", "css": "calc({var} * 1em)" },
    "--default-transition-duration": "semantic.duration.feedback",
    "--default-transition-timing-function": "semantic.easing.enter",
    "--ease-out": "semantic.easing.enter",
    "--ease-move": "semantic.easing.move",
    "--ease-settle": "semantic.easing.settle"
  },
  "root": {
    "--duration-feedback": "semantic.duration.feedback",
    "--duration-reveal": "semantic.duration.reveal",
    "--duration-handoff": "semantic.duration.handoff",
    "--duration-causal": "semantic.duration.causal",
    "--spring-land": "semantic.spring.land"
  },
  "followSystem": {
    "theme": { "light": "(prefers-color-scheme: light)" },
    "motion": { "reduced": "(prefers-reduced-motion: reduce)" }
  }
}
