{
  "component": {
    "$description": "Component layer. References to meaning only.",
    "button": {
      "primary": {
        "$type": "color",
        "background": {
          "$value": "{semantic.color.ink.primary}"
        },
        "text": {
          "$value": "{semantic.color.surface.canvas}"
        }
      },
      "accent": {
        "$type": "color",
        "background": {
          "$value": "{semantic.color.accent.primary}"
        },
        "text": {
          "$value": "{semantic.color.ink.onAccent}"
        }
      },
      "secondary": {
        "$type": "color",
        "border": {
          "$value": "{semantic.color.border.subtle}"
        },
        "text": {
          "$value": "{semantic.color.ink.primary}"
        },
        "background": {
          "$value": "{semantic.color.surface.base}"
        }
      },
      "motion": {
        "$type": "duration",
        "$value": "{semantic.duration.feedback}"
      }
    },
    "inspector": {
      "outline": {
        "$type": "color",
        "$value": "{semantic.color.accent.primary}"
      },
      "label": {
        "$type": "color",
        "background": {
          "$value": "{semantic.color.accent.primary}"
        },
        "text": {
          "$value": "{semantic.color.ink.onAccent}"
        }
      },
      "motion": {
        "$type": "duration",
        "$value": "{semantic.duration.reveal}"
      }
    },
    "glucose": {
      "$type": "color",
      "$description": "Chart paints, independent of the brand accent. Signal labels use neutral ink.",
      "trace": {
        "$value": "{semantic.color.data.trace}"
      },
      "low": {
        "$value": "{semantic.color.status.fail}"
      },
      "inRange": {
        "$value": "{semantic.color.status.pass}"
      },
      "high": {
        "$value": "{semantic.color.status.warn}"
      },
      "grid": {
        "$value": "{semantic.color.border.subtle}",
        "$description": "Supporting grid lines. Neutral text labels carry the values."
      },
      "cursor": {
        "$value": "{semantic.color.ink.primary}",
        "$description": "The selected time, painted at full opacity."
      },
      "pointOutline": {
        "$value": "{semantic.color.surface.base}",
        "$description": "Separates the selected marker from the trace beneath it."
      }
    },
    "dock": {
      "background": {
        "$type": "color",
        "$value": "{semantic.color.surface.raised}"
      },
      "border": {
        "$type": "color",
        "$value": "{semantic.color.border.subtle}"
      },
      "motion": {
        "$type": "duration",
        "$value": "{semantic.duration.handoff}"
      },
      "inset": {
        "$type": "color",
        "$value": "{semantic.color.surface.base}"
      }
    }
  }
}
