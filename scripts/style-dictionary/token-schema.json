{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "portfolio-token-source",
  "$comment": "Local source format used by this portfolio. This is not a DTCG or Primitree conformance schema. References and dark/light values are resolved before validating value types.",
  "$ref": "#/$defs/group",
  "$defs": {
    "group": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-zA-Z0-9_-]+$" },
      "additionalProperties": { "anyOf": [{ "$ref": "#/$defs/token" }, { "$ref": "#/$defs/group" }] }
    },
    "token": {
      "type": "object",
      "required": ["$type", "$value"],
      "additionalProperties": false,
      "properties": {
        "$type": { "enum": ["color", "dimension", "fontFamily", "number", "shadow"] },
        "$value": {},
        "$description": { "type": "string" }
      }
    },
    "color": {
      "type": "object",
      "required": ["r", "g", "b"],
      "additionalProperties": false,
      "properties": {
        "r": { "type": "number", "minimum": 0, "maximum": 255 },
        "g": { "type": "number", "minimum": 0, "maximum": 255 },
        "b": { "type": "number", "minimum": 0, "maximum": 255 },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "dimension": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "unit": { "enum": ["px", "rem", "em"] }
      }
    },
    "fontFamily": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "number": { "type": "number" },
    "shadow": {
      "type": "object",
      "required": ["color", "offsetX", "offsetY", "blur", "spread"],
      "additionalProperties": false,
      "properties": {
        "color": { "type": "string", "pattern": "^(?:#[0-9a-fA-F]{3}|#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8}|rgba?\\(\\s*-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)\\s*,\\s*-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)\\s*,\\s*-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:\\s*,\\s*-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)%?)?\\s*\\)|rgba?\\(\\s*-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)\\s+-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)\\s+-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:\\s*/\\s*-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)%?)?\\s*\\))$" },
        "offsetX": { "$ref": "#/$defs/cssDimension" },
        "offsetY": { "$ref": "#/$defs/cssDimension" },
        "blur": { "$ref": "#/$defs/nonnegativeCssDimension" },
        "spread": { "$ref": "#/$defs/cssDimension" }
      }
    },
    "nonnegativeCssDimension": { "type": "string", "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:px|rem|em)$" },
    "cssDimension": { "type": "string", "pattern": "^-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:px|rem|em)$" }
  }
}
