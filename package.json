{
  "name": "marklearst-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 113",
    "safari >= 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fetch-webfonts.mjs && node scripts/check-webfonts.mjs && pnpm tokens:check && node scripts/check-raw-values.mjs --growth-only && next build",
    "start": "next start",
    "lint": "eslint",
    "tokens:build": "node scripts/tokens/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm tokens:check && pnpm tokens:raw",
    "tokens:check": "node scripts/tokens/build.mjs --check && primitree check",
    "tokens:raw": "node scripts/check-raw-values.mjs",
    "fonts:upload": "node --env-file-if-exists=.env.local scripts/upload-webfonts.mjs",
    "tokens:inspect": "primitree inspect",
    "tokens:accent": "node scripts/tokens/accent.mjs"
  },
  "dependencies": {
    "@figma-vars/hooks": "^4.0.0",
    "@glucoseiq/core": "1.0.0-next.0",
    "@glucoseiq/testing": "1.0.0-next.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@primitree/core": "1.0.0-next.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^1.0.3",
    "@vercel/speed-insights": "^2.1.0",
    "gray-matter": "^4.0.3",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "wawoff2": "2.0.1"
  },
  "devDependencies": {
    "@primitree/cli": "1.0.0-next.1",
    "@primitree/dtcg": "1.0.0-next.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/blob": "^2.9.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.33",
    "postcss-value-parser": "^4.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "unified": "^11.0.5"
  }
}
